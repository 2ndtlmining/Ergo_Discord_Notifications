# Copy to .env and fill in real values. Never commit .env.
# Blank values count as unset.

# --- Discord -----------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx
# Optional: user ID to @mention on alerts
DISCORD_USER=123456789012345678
# Optional: where Discord loads the status icons from (must be public)
# DISCORD_ICON_BASE_URL=https://raw.githubusercontent.com/2ndtlmining/Ergo_Discord_Notifications/main/assets/discord

# --- Reference chain (defaults shown) ---------------------------------------
EXPLORER_MAINNET_API=https://api.ergoplatform.com
EXPLORER_P2P_API=https://api-102.ergoplatform.com

# --- Tuning (defaults shown) ------------------------------------------------
LAG_THRESHOLD_BLOCKS=5
NODE_POLL_SECONDS=30
WALLET_POLL_SECONDS=300
ALERT_COOLDOWN_MINUTES=30
HTTP_PORT=7777

# --- Nodes -------------------------------------------------------------------
# NODE_<n>_NAME / NODE_<n>_URL, n = 1, 2, 3 ... (gaps are fine)
# NODE_<n>_WALLET_ADDRESS is optional: a wallet run by that node (bot/pool).
# The node's REST API (default port 9053) must be reachable from the monitor.
NODE_1_NAME=Grid Bot
NODE_1_URL=http://192.168.1.10:9053
NODE_1_WALLET_ADDRESS=9fExampleGridBotAddressxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NODE_2_NAME=Hosted Explorer
NODE_2_URL=http://192.168.1.11:9053

NODE_3_NAME=Mining Pool
NODE_3_URL=http://192.168.1.12:9053

# --- Standalone wallets -----------------------------------------------------
# WALLET_<n>_NAME / WALLET_<n>_ADDRESS
WALLET_1_NAME=Mining
WALLET_1_ADDRESS=9fExampleMiningAddressxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
